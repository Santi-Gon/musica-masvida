# ===========================================
# Música Más Vida - Variables de Entorno
# ===========================================
# Copia este archivo como .env y ajusta los valores

# --- Base de datos (PostgreSQL) ---
DATABASE_URL="postgresql://admin:password@localhost:5432/musica_mas_vida?schema=public"

# --- API Backend ---
API_PORT=3000
API_HOST=localhost

# --- JWT (Autenticación Admin) ---
JWT_SECRET=tu-secreto-super-seguro-cambialo
JWT_EXPIRES_IN=24h

# --- Web Push Notifications ---
# Genera tus claves VAPID con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com

# --- Frontend ---
VITE_API_URL=http://localhost:3000
