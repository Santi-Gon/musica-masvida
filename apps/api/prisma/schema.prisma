// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ========================
// Modelos - Música Más Vida
// ========================

model Event {
  id          String   @id @default(uuid())
  title       String
  description String
  date        DateTime
  time        String
  location    String
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("events")
}

model Teacher {
  id          String   @id @default(uuid())
  name        String
  bio         String
  photoUrl    String?
  instruments String[] // Array de instrumentos que enseña
  email       String?
  phone       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teachers")
}

model Instrument {
  id          String             @id @default(uuid())
  name        String
  description String
  category    InstrumentCategory
  imageUrl    String?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("instruments")
}

enum InstrumentCategory {
  STRINGS
  WIND
  PERCUSSION
  KEYBOARD
  VOICE
  OTHER
}

model PricingPlan {
  id          String           @id @default(uuid())
  name        String
  description String
  price       Float
  currency    String           @default("MXN")
  frequency   PricingFrequency
  features    String[]         // Lista de beneficios
  isPopular   Boolean          @default(false)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("pricing_plans")
}

enum PricingFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

model AdminUser {
  id        String          @id @default(uuid())
  email     String          @unique
  password  String          // Hash bcrypt
  name      String
  auditLogs UserAuditLog[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("admin_users")
}

// Suscripciones Web Push
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@map("push_subscriptions")
}

// ========================
// Modelos para Prácticas 11 y 12 (Smartwatch)
// ========================

model User {
  id             String             @id @default(uuid())
  email          String             @unique
  password       String             // Hash bcrypt
  name           String
  isActive       Boolean            @default(true) // Baja lógica
  smartwatchPin  String?            // Hash bcrypt del PIN de 6 dígitos
  pinExpiresAt   DateTime?

  medicalReminders   MedicalReminder[]
  physicalActivities PhysicalActivity[]
  auditLogs          UserAuditLog[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("users")
}

// Registro de auditoría de cambios administrativos sobre usuarios
model UserAuditLog {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id])
  action    String    // "EDICION", "BAJA_LOGICA", "REACTIVACION"
  detail    String    // Descripción del cambio
  createdAt DateTime  @default(now())

  @@map("user_audit_logs")
}

model MedicalReminder {
  id          String   @id @default(uuid())
  title       String
  description String?
  time        String   // Ej: "08:00 AM"
  isActive    Boolean  @default(true)
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("medical_reminders")
}

model PhysicalActivity {
  id          String   @id @default(uuid())
  type        String   // Ej: "Correr", "Nadar"
  duration    Int      // En minutos
  calories    Int      // Calorías quemadas
  date        DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("physical_activities")
}

